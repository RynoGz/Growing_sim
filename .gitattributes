# Normalize text while preserving binary assets.
* text=auto

# Source and configuration files.
*.cs text diff=csharp eol=lf
*.json text eol=lf
*.md text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.meta text eol=lf

# Unity YAML assets remain readable and diffable in Git.
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf

# Common binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.fbx binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.mov binary
*.ttf binary
*.otf binary
